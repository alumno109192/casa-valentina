{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve pos --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:admin": "ng serve admin --port 4300",
    "start:menu": "ng serve menu --port 4400",
    "build:pos": "ng build pos --configuration production",
    "build:admin": "ng build admin --configuration production",
    "build:menu": "ng build menu --configuration production",
    "apk": "npm run build:pos && cap sync android && cd android && gradlew assembleDebug"
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
